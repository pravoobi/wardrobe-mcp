# Canonical MCP URL — must match exactly what Alexa+ is configured with
# (scheme, host, path, no trailing slash). Used as the OAuth `resource` value.
MCP_CANONICAL_URL=http://localhost:3000/mcp

# Server
PORT=3000
HOST=0.0.0.0

# `dev_<userId>` bearer tokens — local convenience, auto-off when NODE_ENV=production
ALLOW_DEV_TOKENS=true

# Store backend: sqlite (dev/tests) | dynamodb (prod)
STORE=sqlite
SQLITE_PATH=./data/wardrobe.sqlite
DYNAMODB_TABLE=wardrobe
# DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local

# Object storage for rendered looks: local (dev) | s3 (prod)
STORAGE=local
LOCAL_RENDER_DIR=./renders
PUBLIC_RENDER_BASE_URL=http://localhost:3000/renders
# S3_BUCKET=wardrobe-looks
# CLOUDFRONT_BASE_URL=https://looks.example.com

# Render worker: local (sharp compositor) | browser (Playwright → try-on WebMCP) | stub
RENDER_MODE=local
# How long the `browser` renderer waits for the try-on canvas to stop changing (ms).
RENDER_SETTLE_MS=45000

# Garment auto-tagging: none | bedrock
TAGGING_PROVIDER=none
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Try-on app that the render worker drives
TRYON_APP_URL=https://pravoobi.github.io/try-on/
TRYON_APP_VERSION=dev

# AWS
AWS_REGION=us-east-1
