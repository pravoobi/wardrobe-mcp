{
  "name": "wardrobe-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted MCP server that gives Alexa+ a customer's wardrobe — what they own, what they've saved, what they could buy, and what any of it looks like on them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wardrobe-mcp": "./dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/catalog/catalog.json','dist/catalog/catalog.json')\"",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run test && npm run smoke",
    "sync-catalog": "node src/catalog/sync.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "hono": "^4.6.14",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
